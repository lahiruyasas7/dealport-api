# --- Database ---
# PostgreSQL connection string (e.g. from Prisma Postgres, Supabase, Neon, or Render)
DATABASE_URL=postgresql://user:password@host:5432/dealport?schema=public

# --- Auth ---
# Long random string used to sign/verify JWTs — generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret
# Access token lifetime (e.g. 24h, 7d, 3600s)
JWT_EXPIRES_IN=24h

# --- CORS ---
# Exact origin of the deployed frontend (no trailing slash)
FRONTEND_URL=https://dealport-web.vercel.app

# --- AWS S3 (product image uploads via presigned URL) ---
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dealport-product-images
# IAM user credentials scoped to s3:PutObject on the bucket above only
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-ke